# Django Secret Key & Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,.onrender.com,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=ip_sakti.settings.production

# Supabase PostgreSQL (Use the Session Pooler URL, Port 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Google AI Studio (Gemini Embeddings API)
# Get free key from: https://aistudio.google.com/
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Groq Cloud API (Qwen LLM Generation)
# Get free key from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key

# Jina AI API (Cross-Encoder Reranker)
# Get free key from: https://jina.ai/reranker/
JINA_API_KEY=your-jina-api-key
