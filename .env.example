# Django
SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=ip_sakti.settings.development

# Supabase PostgreSQL
# Use the Supavisor pooler URL (Session mode, port 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# External APIs (Sprint 4-5)
GROQ_API_KEY=
GOOGLE_API_KEY=
JINA_API_KEY=
